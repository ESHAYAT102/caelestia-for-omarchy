{
    "appearance": {
        "deformScale": 0,
        "font": {
            "scale": 0.8
        },
        "padding": {
            "scale": 0.8
        },
        "rounding": {
            "scale": 0.8
        },
        "spacing": {
            "scale": 0.8
        },
        "transparency": {
            "enabled": true
        }
    },
    "background": {
        "enabled": true,
        "wallpaperEnabled": true
    },
    "bar": {
        "activeWindow": {
            "compact": true,
            "showOnHover": false
        },
        "clock": {
            "background": false,
            "showDate": false,
            "showIcon": false
        },
        "entries": [
            {
                "enabled": true,
                "id": "logo"
            },
            {
                "enabled": true,
                "id": "workspaces"
            },
            {
                "enabled": true,
                "id": "updates"
            },
            {
                "enabled": true,
                "id": "spacer"
            },
            {
                "enabled": true,
                "id": "activeWindow"
            },
            {
                "enabled": true,
                "id": "spacer"
            },
            {
                "enabled": true,
                "id": "tray"
            },
            {
                "enabled": true,
                "id": "clock"
            },
            {
                "enabled": true,
                "id": "statusIcons"
            },
            {
                "enabled": true,
                "id": "power"
            }
        ],
        "persistent": true,
        "popouts": {
            "activeWindow": false,
            "statusIcons": true,
            "tray": true
        },
        "scrollActions": {
            "volume": true
        },
        "statusIcons": [
            {
                "enabled": true,
                "id": "audio"
            },
            {
                "enabled": false,
                "id": "microphone"
            },
            {
                "enabled": true,
                "id": "lockStatus"
            },
            {
                "enabled": true,
                "id": "tailscale"
            },
            {
                "enabled": true,
                "id": "network"
            },
            {
                "enabled": true,
                "id": "bluetooth"
            },
            {
                "enabled": true,
                "id": "battery"
            }
        ],
        "tray": {
            "background": false,
            "compact": false,
            "recolour": false
        },
        "workspaces": {
            "activeTrail": true,
            "occupiedBg": false,
            "perMonitorWorkspaces": false,
            "showWindows": true,
            "showWindowsOnSpecialWorkspaces": true,
            "shown": 5
        }
    },
    "border": {
        "rounding": 20,
        "smoothing": 20,
        "thickness": 10
    },
    "general": {
        "apps": {
            "explorer": [
                "nautilus",
                "--new-window"
            ],
            "terminal": [
                "/usr/bin/ghostty",
                "--gtk-single-instance=true"
            ]
        },
        "idle": {
            "inhibitWhenAudio": false,
            "lockBeforeSleep": false,
            "timeouts": [
                {
                    "idleAction": [
                        "/home/esh/.config/omarchy/bridges/caelestia/caelestia-lock"
                    ],
                    "timeout": 310
                }
            ]
        },
        "logo": "/usr/share/pixmaps/archlinux-logo.svg",
        "showOverFullscreen": true
    },
    "launcher": {
        "actionPrefix": ">",
        "actions": [
            {
                "command": [
                    "autocomplete",
                    "calc"
                ],
                "description": "Do simple math equations (powered by Qalc)",
                "icon": "calculate",
                "name": "Calculator"
            },
            {
                "command": [
                    "autocomplete",
                    "scheme"
                ],
                "description": "Change the current colour scheme",
                "icon": "palette",
                "name": "Scheme"
            },
            {
                "command": [
                    "autocomplete",
                    "wallpaper"
                ],
                "description": "Change the current wallpaper",
                "icon": "image",
                "name": "Wallpaper"
            },
            {
                "command": [
                    "autocomplete",
                    "variant"
                ],
                "description": "Change the current scheme variant",
                "icon": "colors",
                "name": "Variant"
            },
            {
                "command": [
                    "caelestia",
                    "wallpaper",
                    "-r"
                ],
                "description": "Switch to a random wallpaper",
                "icon": "casino",
                "name": "Random"
            },
            {
                "command": [
                    "setMode",
                    "light"
                ],
                "description": "Change the scheme to light mode",
                "icon": "light_mode",
                "name": "Light"
            },
            {
                "command": [
                    "setMode",
                    "dark"
                ],
                "description": "Change the scheme to dark mode",
                "icon": "dark_mode",
                "name": "Dark"
            },
            {
                "command": [
                    "poweroff"
                ],
                "dangerous": true,
                "description": "Shutdown the system",
                "icon": "power_settings_new",
                "name": "Shutdown"
            },
            {
                "command": [
                    "reboot"
                ],
                "dangerous": true,
                "description": "Reboot the system",
                "icon": "cached",
                "name": "Reboot"
            },
            {
                "command": [
                    "logout"
                ],
                "dangerous": true,
                "description": "Log out of the current session",
                "icon": "exit_to_app",
                "name": "Logout"
            },
            {
                "command": [
                    "loginctl",
                    "lock-session"
                ],
                "description": "Lock the current session",
                "icon": "lock",
                "name": "Lock"
            },
            {
                "command": [
                    "suspendThenHibernate"
                ],
                "description": "Suspend then hibernate",
                "icon": "bedtime",
                "name": "Sleep"
            },
            {
                "command": [
                    "caelestia",
                    "shell",
                    "nexus",
                    "open"
                ],
                "description": "Configure the shell",
                "icon": "settings",
                "name": "Settings"
            },
            {
                "command": [
                    "autocomplete",
                    "clipboard"
                ],
                "description": "Browse clipboard history",
                "icon": "content_paste",
                "name": "Clipboard"
            },
            {
                "command": [
                    "autocomplete",
                    "unlock"
                ],
                "description": "Change the Omarchy unlock screen",
                "icon": "lock_open",
                "name": "Unlock"
            },
            {
                "command": [
                    "xdg-terminal-exec",
                    "--app-id=org.omarchy.terminal",
                    "omarchy-pkg-install"
                ],
                "description": "Install an Arch or OPR package",
                "icon": "download",
                "name": "Install Package"
            },
            {
                "command": [
                    "xdg-terminal-exec",
                    "--app-id=org.omarchy.terminal",
                    "omarchy-pkg-aur-install"
                ],
                "description": "Install a package from the AUR",
                "icon": "deployed_code",
                "name": "Install AUR Package"
            },
            {
                "command": [
                    "xdg-terminal-exec",
                    "--app-id=org.omarchy.terminal",
                    "omarchy-pkg-remove"
                ],
                "description": "Remove an installed package",
                "icon": "delete",
                "name": "Remove Package"
            },
            {
                "command": [
                    "omarchy-launch-floating-terminal-with-presentation",
                    "omarchy-update"
                ],
                "description": "Update Omarchy and all packages",
                "icon": "system_update",
                "name": "Update System"
            }
        ],
        "hiddenApps": [
            "bvnc",
            "bssh",
            "avahi-discover"
        ],
        "showOnHover": false
    },
    "lock": {
        "enabled": true
    },
    "services": {
        "audioIncrement": 0.05,
        "useFahrenheit": false
    },
    "session": {
        "commands": {
            "logout": [
                "omarchy-system-logout"
            ]
        },
        "enabled": true
    },
    "utilities": {
        "toasts": {
            "kbLayoutChanged": false
        }
    }
}

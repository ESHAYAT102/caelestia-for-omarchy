#!/bin/bash
#
# List pending updates as JSON: [{name, old, new, source}].
# Sources: pacman repo packages, AUR via yay, flatpaks and mise tools.
# Read-only; safe to run for status checks.

python3 - <<'PY'
import json
import subprocess


def run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=180).stdout
    except Exception:
        return ""


rows = []

# Pacman repo packages: "name oldver -> newver"
for line in run(["checkupdates"]).splitlines():
    parts = line.split(" -> ")
    if len(parts) != 2:
        continue
    name_old = parts[0].split()
    if len(name_old) >= 2:
        rows.append({"name": name_old[0], "old": name_old[1], "new": parts[1].strip(), "source": "pacman"})

# AUR packages: "name oldver -> newver ..."
for line in run(["yay", "-Qua"]).splitlines():
    parts = line.split(" -> ")
    if len(parts) != 2:
        continue
    name_old = parts[0].split()
    if len(name_old) >= 2:
        rows.append({"name": name_old[0], "old": name_old[1], "new": parts[1].strip().split()[0], "source": "aur"})

# Flatpaks: match available updates against installed versions.
installed = {}
for line in run(["flatpak", "list", "--columns=application,version"]).splitlines():
    cols = line.split("\t")
    if len(cols) >= 2 and cols[0].strip():
        installed[cols[0].strip()] = cols[1].strip()
for line in run(["flatpak", "remote-ls", "--updates", "--columns=application,version,name"]).splitlines():
    cols = line.split("\t")
    if len(cols) < 3:
        continue
    app, version, name = cols[0].strip(), cols[1].strip(), cols[2].strip()
    if app in installed:
        rows.append({"name": name or app, "old": installed[app], "new": version or "update available", "source": "flatpak"})

# Mise tools.
try:
    outdated = json.loads(run(["mise", "outdated", "--json"]) or "{}")
except ValueError:
    outdated = {}
for tool, info in outdated.items():
    if not isinstance(info, dict):
        continue
    rows.append({"name": tool, "old": str(info.get("current", "")), "new": str(info.get("latest", "")), "source": "mise"})

print(json.dumps(rows))
PY

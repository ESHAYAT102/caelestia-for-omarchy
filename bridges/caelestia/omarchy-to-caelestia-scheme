#!/usr/bin/env python3
"""Write Omarchy's active palette into the file Caelestia watches.

Source of truth: `omarchy-theme-color --all` — Omarchy's own resolver, so the
legacy colorN themes, the orange/brown/dark_background fallbacks and the
light/dark detection behave exactly as they do for every other Omarchy consumer.
Parsing colors.toml here instead would silently disagree with them.

Target: ~/.local/state/caelestia/scheme.json.  services/Colours.qml holds a
FileView on it with watchChanges:true; load() maps <key> -> m3<Key> (term* pass
through) and ignores keys the palette lacks, so only the M3Palette property
names matter.  Caelestia never writes this file — the bridge is one-directional.

Nothing here talks to Caelestia, so a theme switch works identically whether it
is running or not.

Usage:  omarchy-to-caelestia-scheme [theme-slug]
        omarchy-to-caelestia-scheme --check    # verify the last write
"""

import colorsys
import json
import os
import re
import subprocess
import sys

STATE = os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
    "caelestia")
OUT = os.path.join(STATE, "scheme.json")
COLOURS_QML = os.path.expanduser(
    "~/.local/share/caelestia-shell/qs/services/Colours.qml")

HEX = re.compile(r"^#[0-9A-Fa-f]{6}$")


# The palette Omarchy documents and guarantees.  Everything else a theme may
# ship (active_border_color, hyprland_active_border, ...) is per-app config,
# not a palette entry -- and the hyprland_* ones are gradient syntax, not even
# a colour.
PALETTE = ("accent selection muted background dark_background darker_background "
           "lighter_background foreground dark_foreground light_foreground "
           "bright_foreground red yellow orange green cyan blue magenta brown "
           "bright_red bright_yellow bright_green bright_cyan bright_blue "
           "bright_magenta").split()

# The theme's identity: these must reach Caelestia byte-exact or the shells
# disagree about what the theme looks like.  The rest are shades, and a shade
# may be lifted for contrast -- see ensure().
IDENTITY = ("accent background foreground red yellow green cyan blue magenta "
            "muted bright_foreground bright_red bright_yellow bright_green "
            "bright_cyan bright_blue bright_magenta").split()


def palette():
    out = subprocess.run(["omarchy-theme-color", "--all"],
                         capture_output=True, text=True, check=True).stdout
    p = dict(l.split("\t", 1) for l in out.splitlines() if "\t" in l)
    # A theme directory with no colors.toml (this machine has one: the empty
    # ~/.config/omarchy/themes/aether) resolves to blanks.  Omarchy itself
    # skips template generation for those, so there is nothing to mirror.
    if not all(HEX.match(p.get(k, "")) for k in ("background", "foreground", "accent")):
        print("omarchy-to-caelestia-scheme: active theme has no colors.toml, "
              "leaving scheme.json as it is", file=sys.stderr)
        sys.exit(0)
    return p


# --- colour maths ----------------------------------------------------------

def rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def hexs(t):
    return "#%02x%02x%02x" % tuple(max(0, min(255, round(v))) for v in t)


def mix(a, b, t):
    return hexs([x + (y - x) * t for x, y in zip(rgb(a), rgb(b))])


def lum(h):
    c = [v / 255 for v in rgb(h)]
    c = [v / 12.92 if v <= 0.03928 else ((v + 0.055) / 1.055) ** 2.4 for v in c]
    return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]


def contrast(a, b):
    la, lb = lum(a), lum(b)
    return (max(la, lb) + 0.05) / (min(la, lb) + 0.05)


def desat(h, amount):
    hh, l, s = colorsys.rgb_to_hls(*[v / 255 for v in rgb(h)])
    return hexs([v * 255 for v in colorsys.hls_to_rgb(hh, l, s * amount)])


def ensure(c, against, ratio):
    """Lift c away from `against` until it meets `ratio`, keeping hue.

    Omarchy's palette is a set of hues, not a set of tones: `muted` and the
    accents land wherever the theme author put them, so a role taken verbatim
    can be unreadable on a surface it was never meant to sit on.  Moving only
    lightness keeps the theme's colour recognisable while making it legible.
    Returns c untouched whenever the theme is already fine, which is the
    common case.
    """
    if contrast(c, against) >= ratio:
        return c
    up = contrast("#ffffff", against) >= contrast("#000000", against)
    hh, l, s = colorsys.rgb_to_hls(*[v / 255 for v in rgb(c)])
    for i in range(1, 21):
        nl = l + (1 - l) * i / 20 if up else l * (1 - i / 20)
        cand = hexs([v * 255 for v in colorsys.hls_to_rgb(hh, nl, s)])
        if contrast(cand, against) >= ratio:
            return cand
    return "#ffffff" if up else "#000000"


# --- the mapping -----------------------------------------------------------

def build(p):
    bg, fg = p["background"], p["foreground"]
    light = p.get("mode", "dark") == "light"

    def on(x):
        """Text colour for x: the theme extreme that reads better, lifted to AA."""
        best = fg if contrast(fg, x) >= contrast(bg, x) else bg
        return ensure(best, x, 4.5)

    # M3's own container tones sit ~30% (dark) / ~15% (light) from the surface
    # toward the role colour; measured off the reference M3 palettes.
    def container(x):
        return mix(bg, x, 0.15 if light else 0.30)

    # The four background tones plus selection ARE the container ramp, ordered
    # away from the text: darkest-first in a dark theme, lightest-first in a
    # light one.  Sorting rather than trusting the names matters because
    # `lighter_background` is darker than `background` in several light themes.
    ramp = sorted([p["background"], p["dark_background"], p["darker_background"],
                   p["lighter_background"], p["selection"]],
                  key=lambda h: -abs(lum(h) - lum(fg)))
    lowest, low, cont, high, highest = ramp

    accent = p["accent"]
    # M3 secondary is primary at lower chroma.  Desaturating the accent keeps
    # its lightness, so secondary reads on the same surfaces primary does;
    # mixing it toward `muted` instead drags it to mid-grey and kills contrast.
    secondary = desat(accent, 0.5)

    s = {
        # Terminal 16: byte-exact copy of Omarchy's own ANSI mapping in
        # default/themed/alacritty.toml.tpl, so Caelestia and the terminal agree.
        "term0": bg,                     "term8": p["muted"],
        "term1": p["red"],               "term9": p["bright_red"],
        "term2": p["green"],             "term10": p["bright_green"],
        "term3": p["yellow"],            "term11": p["bright_yellow"],
        "term4": p["blue"],              "term12": p["bright_blue"],
        "term5": p["magenta"],           "term13": p["bright_magenta"],
        "term6": p["cyan"],              "term14": p["bright_cyan"],
        "term7": fg,                     "term15": p["bright_foreground"],

        # Surfaces
        "background": bg,
        "surface": bg,
        "surfaceDim": lowest,
        "surfaceBright": highest,
        "surfaceContainerLowest": lowest,
        "surfaceContainerLow": low,
        "surfaceContainer": cont,
        "surfaceContainerHigh": high,
        "surfaceContainerHighest": highest,
        "surfaceVariant": low,
        "onBackground": fg,
        "onSurface": fg,
        # The three roles Caelestia renders as body text.  m3outline is a text
        # colour here far more than a border one (51 of its 74 uses are a
        # Text/Icon `color:`), so it is held to AA like the others.
        "onSurfaceVariant": ensure(p["light_foreground"], cont, 4.5),
        "outline": ensure(p["muted"], cont, 4.5),
        "outlineVariant": ensure(p["dark_foreground"], cont, 3.0),
        "inverseSurface": fg,
        "inverseOnSurface": bg,
        "inversePrimary": ensure(mix(accent, bg, 0.5), fg, 3.0),
        "surfaceTint": accent,
        "shadow": "#000000",
        "scrim": "#000000",

        # Tonal key colours: not rendered, but they are where a palette entry
        # with no UI role of its own belongs.  `brown` is one — Omarchy uses it
        # only in neovim.lua.tpl, and forcing it into tertiaryContainer would
        # make every theme's containers muddy.
        "primary_paletteKeyColor": accent,
        "secondary_paletteKeyColor": secondary,
        "tertiary_paletteKeyColor": p["brown"],
        "neutral_paletteKeyColor": p["muted"],
        "neutral_variant_paletteKeyColor": p["dark_foreground"],
    }

    for name, base in (("primary", accent), ("secondary", secondary),
                       ("tertiary", p["orange"]), ("error", p["red"]),
                       ("success", p["green"])):
        n = name[0].upper() + name[1:]
        ctr = container(base)
        s[name] = base
        s["on" + n] = on(base)
        s[name + "Container"] = ctr
        s["on" + n + "Container"] = on(ctr)
        if name in ("primary", "secondary", "tertiary"):
            s[name + "Fixed"] = ctr
            s[name + "FixedDim"] = base
            s["on" + n + "Fixed"] = on(ctr)
            s["on" + n + "FixedVariant"] = on(ctr)

    return {
        "name": "omarchy",
        "flavour": flavour(),
        "mode": "light" if light else "dark",
        "variant": "tonalspot",
        "colours": {k: v.lstrip("#").lower() for k, v in s.items()},
    }


def flavour():
    if len(sys.argv) > 1 and not sys.argv[1].startswith("-"):
        return sys.argv[1]
    try:
        with open(os.path.expanduser(
                "~/.local/state/omarchy/current/theme.name")) as f:
            return f.read().strip()
    except OSError:
        return "unknown"


# --- self-check ------------------------------------------------------------

def check():
    """Fails if the mapping loses an identity colour or a Caelestia token."""
    p = palette()
    s = json.load(open(OUT))
    written = set(s["colours"].values())

    def missing(keys):
        return sorted(k for k in keys
                      if HEX.match(p.get(k, ""))
                      and p[k].lstrip("#").lower() not in written)

    lost = missing(IDENTITY)
    assert not lost, f"identity colours missing from scheme.json: {lost}"

    assert s["mode"] == p["mode"], f"mode not carried: {s['mode']} != {p['mode']}"

    lifted = missing(PALETTE)

    if os.path.exists(COLOURS_QML):
        src = open(COLOURS_QML).read()
        block = src[src.index("component M3Palette"):]
        want = set(re.findall(r"property color (\w+)", block[:block.index("\n    }")]))
        have = {("term" + k[4:]) if k.startswith("term") else "m3" + k
                for k in s["colours"]}
        assert want == have, f"token mismatch: missing {want - have}, extra {have - want}"

    have = sum(1 for k in PALETTE if HEX.match(p.get(k, "")))
    print(f"PASS  {have - len(lifted)}/{have} palette colours exact"
          + (f", {len(lifted)} lifted for contrast: {', '.join(lifted)}" if lifted else "")
          + f" -> {len(s['colours'])} tokens, mode={s['mode']}, flavour={s['flavour']}")


def main():
    if "--check" in sys.argv:
        return check()
    scheme = build(palette())
    os.makedirs(STATE, exist_ok=True)
    tmp = OUT + ".tmp"
    with open(tmp, "w") as f:
        json.dump(scheme, f, indent=2, sort_keys=True)
        f.write("\n")
    os.replace(tmp, OUT)   # atomic: Caelestia's FileView never sees a half file


if __name__ == "__main__":
    main()
